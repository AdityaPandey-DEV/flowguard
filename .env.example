# FlowGuard Backend — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git! It contains secrets.

# MongoDB Atlas connection string (REQUIRED)
# Get this from: https://cloud.mongodb.com → Clusters → Connect → Drivers
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/flowguard?retryWrites=true&w=majority

# Server port
PORT=5000

# Rate limiting defaults
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW=60

# Job queue settings
MAX_QUEUE_SIZE=1000
WORKER_THREADS=2
